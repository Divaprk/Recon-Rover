{
    "configurations": [
        {
            "name": "Pico",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:PICO_SDK_PATH}/**"
            ],
            "defines": [
                "PICO_DEFAULT_UART=0",
                "PICO_DEFAULT_UART_TX_PIN=0",
                "PICO_DEFAULT_UART_RX_PIN=1",
                "PICO_DEFAULT_LED_PIN=25"
            ],
            "compilerPath": "arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}